//@version=6
strategy("UT Bot + Structure Fusion - Strategy", overlay = true, default_qty_type = strategy.percent_of_equity, default_qty_value = 10, initial_capital = 10000, commission_type = strategy.commission.percent, commission_value = 0.04)

// ============================================================================
// INPUTS
// ============================================================================
sensitivity    = input.float(2.0, "Signal Sensitivity")
utAtrPeriod    = input.int(1, "UT Bot ATR Period", minval = 1)
entryMode      = input.string("UT Bot Only", "Entry Mode", options = ["UT Bot Only", "UT Bot + Structure Confluence", "Structure Breakout (CHoCH)"])
tradeDirection = input.string("Both", "Signal Direction", options = ["Both", "Buy Only", "Sell Only"])
swingLookback  = input.int(5, "Swing Lookback", minval = 1)
riskAtrLen     = input.int(14, "Risk ATR Length", minval = 1)
slMode         = input.string("Structure", "Stop Loss Mode", options = ["ATR-Based", "Fixed Distance", "Structure"])
tpMode         = input.string("Structure", "Take Profit Mode", options = ["ATR-Based", "Fixed Distance", "Structure"])
atrMinMult     = input.float(0.5, "Min SL Distance (x ATR)")
atrFallbackMult= input.float(1.5, "ATR Fallback Multiple")
beMode         = input.string("TP1", "Move SL to Breakeven At", options = ["TP1", "TP2", "TP3", "Off"])

// UT Bot Engine
xATR  = ta.atr(utAtrPeriod)
nLoss = sensitivity * xATR
src   = close

var float xATRTrailingStop = 0.0
xATRTrailingStop := src > nz(xATRTrailingStop[1], 0) and src[1] > nz(xATRTrailingStop[1], 0) ? math.max(nz(xATRTrailingStop[1]), src - nLoss) :
   src < nz(xATRTrailingStop[1], 0) and src[1] < nz(xATRTrailingStop[1], 0) ? math.min(nz(xATRTrailingStop[1]), src + nLoss) :
   src > nz(xATRTrailingStop[1], 0) ? src - nLoss : src + nLoss

above = ta.crossover(src, xATRTrailingStop)
below = ta.crossover(xATRTrailingStop, src)
buy   = src > xATRTrailingStop and above
sell  = src < xATRTrailingStop and below

// Market Structure
swingHigh = ta.pivothigh(high, swingLookback, swingLookback)
swingLow  = ta.pivotlow(low, swingLookback, swingLookback)
var array<float> swingHighs = array.new_float(0)
var array<float> swingLows  = array.new_float(0)
if not na(swingHigh)
    array.push(swingHighs, swingHigh)
if not na(swingLow)
    array.push(swingLows, swingLow)

lastSwingHigh = array.size(swingHighs) > 0 ? array.get(swingHighs, array.size(swingHighs) - 1) : na
lastSwingLow  = array.size(swingLows) > 0 ? array.get(swingLows, array.size(swingLows) - 1) : na

var int trend = 0
bullishBreak = not na(lastSwingHigh) and ta.crossover(close, lastSwingHigh)
bearishBreak = not na(lastSwingLow) and ta.crossunder(close, lastSwingLow)
if bullishBreak
    trend := 1
if bearishBreak
    trend := -1

bullishCHoCH = bullishBreak and trend != 1
bearishCHoCH = bearishBreak and trend != -1

// Entry conditions
directionAllowsBuy  = tradeDirection == "Both" or tradeDirection == "Buy Only"
directionAllowsSell = tradeDirection == "Both" or tradeDirection == "Sell Only"

candBuy  = entryMode == "UT Bot Only" ? buy : entryMode == "UT Bot + Structure Confluence" ? (buy and trend == 1) : bullishCHoCH
candSell = entryMode == "UT Bot Only" ? sell : entryMode == "UT Bot + Structure Confluence" ? (sell and trend == -1) : bearishCHoCH

atrVal = ta.atr(riskAtrLen)

if candBuy and directionAllowsBuy
    slPrice = not na(lastSwingLow) and lastSwingLow < close ? lastSwingLow : close - atrVal * atrMinMult
    tpPrice = not na(lastSwingHigh) and lastSwingHigh > close ? lastSwingHigh : close + atrVal * atrFallbackMult
    strategy.entry("Long", strategy.long)
    strategy.exit("Exit Long", "Long", stop = slPrice, limit = tpPrice)

if candSell and directionAllowsSell
    slPrice = not na(lastSwingHigh) and lastSwingHigh > close ? lastSwingHigh : close + atrVal * atrMinMult
    tpPrice = not na(lastSwingLow) and lastSwingLow < close ? lastSwingLow : close - atrVal * atrFallbackMult
    strategy.entry("Short", strategy.short)
    strategy.exit("Exit Short", "Short", stop = slPrice, limit = tpPrice)
