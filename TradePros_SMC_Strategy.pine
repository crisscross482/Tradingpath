//@version=5
strategy("TradePros SMC & Trend Backtest Strategy [Gold / XAUUSD]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=5, commission_type=strategy.commission.percent, commission_value=0.01)

// ==========================================
// 1. INPUT SETTINGS
// ==========================================
grp_trend   = "Trend & Dynamic Ribbon Settings"
ribbon_type = input.string("EMA", "Ribbon Type", options=["EMA", "SMA", "RMA"], group=grp_trend)
fast_len    = input.int(10, "Fast Baseline Length", minval=1, group=grp_trend)
slow_len    = input.int(30, "Slow Baseline Length", minval=1, group=grp_trend)
trend_len   = input.int(200, "Major Trend Filter (200 EMA)", minval=1, group=grp_trend)
use_trend   = input.bool(true, "Filter by Major Trend", group=grp_trend)

grp_risk    = "Risk Management (ATR & TP/SL)"
atr_len     = input.int(14, "ATR Length", minval=1, group=grp_risk)
atr_mult_sl = input.float(1.5, "Stop Loss ATR Multiplier", minval=0.5, step=0.1, group=grp_risk)
tp1_mult_r  = input.float(1.0, "TP1 Target (R:R)", minval=0.5, step=0.25, group=grp_risk)
tp2_mult_r  = input.float(2.0, "TP2 Target (R:R)", minval=1.0, step=0.5, group=grp_risk)
tp3_mult_r  = input.float(3.0, "TP3 Target (R:R)", minval=1.5, step=0.5, group=grp_risk)

grp_scaling = "TP Partial Exit Percentages"
tp1_pct     = input.float(33.3, "TP1 Exit Quantity (%)", minval=0.0, maxval=100.0, step=5, group=grp_scaling)
tp2_pct     = input.float(33.3, "TP2 Exit Quantity (%)", minval=0.0, maxval=100.0, step=5, group=grp_scaling)
tp3_pct     = input.float(33.4, "TP3 Exit Quantity (%)", minval=0.0, maxval=100.0, step=5, group=grp_scaling)

grp_dates   = "Backtest Date Range"
use_dates   = input.bool(false, "Filter By Date Range", group=grp_dates)
start_date  = input.time(timestamp("2024-01-01 00:00"), "Start Date", group=grp_dates)
end_date    = input.time(timestamp("2030-01-01 00:00"), "End Date", group=grp_dates)
in_date     = not use_dates or (time >= start_date and time <= end_date)

// ==========================================
// 2. INDICATORS & TREND RIBBON
// ==========================================
f_ma(src, len, mtype) =>
    mtype == "EMA" ? ta.ema(src, len) :
     mtype == "SMA" ? ta.sma(src, len) :
     ta.rma(src, len)

fast_ma  = f_ma(close, fast_len, ribbon_type)
slow_ma  = f_ma(close, slow_len, ribbon_type)
trend_ma = ta.ema(close, trend_len)
atr_val  = ta.atr(atr_len)

is_bullish_trend = fast_ma > slow_ma and (not use_trend or close > trend_ma)
is_bearish_trend = fast_ma < slow_ma and (not use_trend or close < trend_ma)

p1 = plot(fast_ma, "Fast Ribbon", color=color.new(color.green, 20), linewidth=1)
p2 = plot(slow_ma, "Slow Ribbon", color=color.new(color.red, 20), linewidth=1)
fill(p1, p2, color = fast_ma > slow_ma ? color.new(color.green, 80) : color.new(color.red, 80), title="Ribbon Cloud")
plot(use_trend ? trend_ma : na, "Trend Filter 200 EMA", color=color.blue, linewidth=2)

// ==========================================
// 3. ENTRY SIGNALS
// ==========================================
bull_cross    = ta.crossover(fast_ma, slow_ma)
bear_cross    = ta.crossunder(fast_ma, slow_ma)
bull_pullback = is_bullish_trend and low[1] <= fast_ma and close > fast_ma and close > open
bear_pullback = is_bearish_trend and high[1] >= fast_ma and close < fast_ma and close < open

buy_condition  = (bull_cross or bull_pullback) and (not use_trend or close > trend_ma) and in_date
sell_condition = (bear_cross or bear_pullback) and (not use_trend or close < trend_ma) and in_date

// ==========================================
// 4. STRATEGY EXECUTION & RISK MANAGEMENT
// ==========================================
var float entry_price = na
var float sl_price = na
var float tp1_price = na
var float tp2_price = na
var float tp3_price = na

if buy_condition and strategy.position_size == 0
    entry_price := close
    sl_dist = atr_val * atr_mult_sl
    sl_price := entry_price - sl_dist
    tp1_price := entry_price + (sl_dist * tp1_mult_r)
    tp2_price := entry_price + (sl_dist * tp2_mult_r)
    tp3_price := entry_price + (sl_dist * tp3_mult_r)

    strategy.entry("Buy", strategy.long)
    strategy.exit("Buy TP1", from_entry="Buy", qty_percent=tp1_pct, limit=tp1_price, stop=sl_price)
    strategy.exit("Buy TP2", from_entry="Buy", qty_percent=tp2_pct, limit=tp2_price, stop=sl_price)
    strategy.exit("Buy TP3", from_entry="Buy", limit=tp3_price, stop=sl_price)

if sell_condition and strategy.position_size == 0
    entry_price := close
    sl_dist = atr_val * atr_mult_sl
    sl_price := entry_price + sl_dist
    tp1_price := entry_price - (sl_dist * tp1_mult_r)
    tp2_price := entry_price - (sl_dist * tp2_mult_r)
    tp3_price := entry_price - (sl_dist * tp3_mult_r)

    strategy.entry("Sell", strategy.short)
    strategy.exit("Sell TP1", from_entry="Sell", qty_percent=tp1_pct, limit=tp1_price, stop=sl_price)
    strategy.exit("Sell TP2", from_entry="Sell", qty_percent=tp2_pct, limit=tp2_price, stop=sl_price)
    strategy.exit("Sell TP3", from_entry="Sell", limit=tp3_price, stop=sl_price)

// Plot stop loss and take profits when in position
plot(strategy.position_size > 0 ? sl_price : na, "Long SL", color=color.red, style=plot.style_linebr, linewidth=2)
plot(strategy.position_size > 0 ? tp1_price : na, "Long TP1", color=color.green, style=plot.style_linebr, linewidth=1)
plot(strategy.position_size > 0 ? tp2_price : na, "Long TP2", color=color.green, style=plot.style_linebr, linewidth=2)

plot(strategy.position_size < 0 ? sl_price : na, "Short SL", color=color.red, style=plot.style_linebr, linewidth=2)
plot(strategy.position_size < 0 ? tp1_price : na, "Short TP1", color=color.green, style=plot.style_linebr, linewidth=1)
plot(strategy.position_size < 0 ? tp2_price : na, "Short TP2", color=color.green, style=plot.style_linebr, linewidth=2)
