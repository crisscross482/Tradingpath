//@version=5
indicator("TradePros SMC Trend System [Gold/XAUUSD]", overlay=true, max_boxes_count=500, max_labels_count=500)

// ============================================================================
// 1. INPUT CONFIGURATIONS
// ============================================================================
grp_trend = "Trend Cloud & Ribbon Settings"
fast_len = input.int(10, "Fast Ribbon EMA Length", minval=1, group=grp_trend)
slow_len = input.int(30, "Slow Ribbon EMA Length", minval=1, group=grp_trend)
use_trend_filter = input.bool(true, "Use 200 EMA Baseline Filter", group=grp_trend)
base_len = input.int(200, "Baseline EMA Length", minval=1, group=grp_trend)

grp_fvg = "Fair Value Gap (FVG) Settings"
show_fvg = input.bool(true, "Display Fair Value Gaps", group=grp_fvg)
fvg_threshold = input.float(0.0, "Minimum Gap Threshold (ATR Multiple)", step=0.1, group=grp_fvg)
bull_fvg_col = input.color(color.new(#089981, 75), "Bullish FVG Box Color", group=grp_fvg)
bear_fvg_col = input.color(color.new(#f23645, 75), "Bearish FVG Box Color", group=grp_fvg)

grp_structure = "Market Structure (BOS / CHOCH)"
show_structure = input.bool(true, "Show BOS / CHOCH Breakouts", group=grp_structure)
swing_length = input.int(5, "Swing High / Low Lookback", minval=1, group=grp_structure)

grp_risk = "Target & Risk-Reward Projections"
show_tp_sl = input.bool(true, "Show Entry Target & SL Projections", group=grp_risk)
atr_period = input.int(14, "ATR Period for SL/TP", minval=1, group=grp_risk)
sl_mult = input.float(1.5, "Stop Loss ATR Multiple", minval=0.5, step=0.1, group=grp_risk)
tp1_mult = input.float(1.5, "Take Profit 1 (TP1) R:R Multiple", minval=0.5, step=0.1, group=grp_risk)
tp2_mult = input.float(3.0, "Take Profit 2 (TP2) R:R Multiple", minval=1.0, step=0.1, group=grp_risk)
tp3_mult = input.float(4.5, "Take Profit 3 (TP3) R:R Multiple", minval=1.5, step=0.1, group=grp_risk)

// ============================================================================
// 2. INDICATOR ENGINE CALCULATIONS
// ============================================================================
fast_ema = ta.ema(close, fast_len)
slow_ema = ta.ema(close, slow_len)
base_ema = ta.ema(close, base_len)
atr_val = ta.atr(atr_period)

is_bullish_trend = fast_ema > slow_ema and (not use_trend_filter or close > base_ema)
is_bearish_trend = fast_ema < slow_ema and (not use_trend_filter or close < base_ema)

// Dynamic Ribbon Cloud
p_fast = plot(fast_ema, "Fast Ribbon EMA", color=color.new(#26a69a, 20), linewidth=2)
p_slow = plot(slow_ema, "Slow Ribbon EMA", color=color.new(#ef5350, 20), linewidth=2)
ribbon_col = fast_ema >= slow_ema ? color.new(#089981, 80) : color.new(#f23645, 80)
fill(p_fast, p_slow, color=ribbon_col, title="Ribbon Cloud")

plot(use_trend_filter ? base_ema : na, "200 EMA Baseline", color=color.new(#fbc02d, 10), linewidth=2)

// ============================================================================
// 3. FAIR VALUE GAPS (FVG)
// ============================================================================
var box[] fvg_boxes = array.new_box()

// Bullish FVG: Low of bar 0 > High of bar 2
is_bull_fvg = show_fvg and (low > high[2]) and ((low - high[2]) >= atr_val * fvg_threshold)
// Bearish FVG: High of bar 0 < Low of bar 2
is_bear_fvg = show_fvg and (high < low[2]) and ((low[2] - high) >= atr_val * fvg_threshold)

if is_bull_fvg
    b = box.new(left=bar_index[2], top=low, right=bar_index + 10, bottom=high[2],
                 bgcolor=bull_fvg_col, border_color=color.new(bull_fvg_col, 40))
    array.push(fvg_boxes, b)

if is_bear_fvg
    b = box.new(left=bar_index[2], top=low[2], right=bar_index + 10, bottom=high,
                 bgcolor=bear_fvg_col, border_color=color.new(bear_fvg_col, 40))
    array.push(fvg_boxes, b)

// Clean up old boxes to avoid hitting resource limits
if array.size(fvg_boxes) > 40
    old_box = array.shift(fvg_boxes)
    box.delete(old_box)

// ============================================================================
// 4. MARKET STRUCTURE BREAKOUTS (BOS & CHOCH)
// ============================================================================
swing_high = ta.pivothigh(high, swing_length, swing_length)
swing_low = ta.pivotlow(low, swing_length, swing_length)

var float last_sh = na
var float last_sl = na
var int market_trend = 0 // 1: bullish, -1: bearish

if not na(swing_high)
    last_sh := swing_high

if not na(swing_low)
    last_sl := swing_low

bullish_bos = show_structure and not na(last_sh) and ta.crossover(close, last_sh) and market_trend == 1
bullish_choch = show_structure and not na(last_sh) and ta.crossover(close, last_sh) and market_trend != 1

bearish_bos = show_structure and not na(last_sl) and ta.crossunder(close, last_sl) and market_trend == -1
bearish_choch = show_structure and not na(last_sl) and ta.crossunder(close, last_sl) and market_trend != -1

if bullish_bos or bullish_choch
    market_trend := 1
if bearish_bos or bearish_choch
    market_trend := -1

if bullish_bos
    label.new(bar_index, high, "BOS", color=color.new(#089981, 0), textcolor=color.white,
              style=label.style_label_down, size=size.tiny)
if bullish_choch
    label.new(bar_index, high, "CHOCH", color=color.new(#00897b, 0), textcolor=color.white,
              style=label.style_label_down, size=size.tiny)

if bearish_bos
    label.new(bar_index, low, "BOS", color=color.new(#f23645, 0), textcolor=color.white,
              style=label.style_label_up, size=size.tiny)
if bearish_choch
    label.new(bar_index, low, "CHOCH", color=color.new(#d32f2f, 0), textcolor=color.white,
              style=label.style_label_up, size=size.tiny)

// ============================================================================
// 5. CONFLUENCE SIGNALS & TARGET PROJECTIONS
// ============================================================================
buy_trigger = ta.crossover(fast_ema, slow_ema) and (not use_trend_filter or close > base_ema)
sell_trigger = ta.crossunder(fast_ema, slow_ema) and (not use_trend_filter or close < base_ema)

var float entry_price = na
var float sl_price = na
var float tp1_price = na
var float tp2_price = na
var float tp3_price = na

if buy_trigger
    entry_price := close
    sl_price := close - (atr_val * sl_mult)
    risk = entry_price - sl_price
    tp1_price := entry_price + (risk * tp1_mult)
    tp2_price := entry_price + (risk * tp2_mult)
    tp3_price := entry_price + (risk * tp3_mult)

    label.new(bar_index, low - (atr_val * 0.5), "BUY\n" + str.tostring(close, "#.##"),
              color=#089981, textcolor=color.white, style=label.style_label_up, size=size.small)

    if show_tp_sl
        box.new(left=bar_index, top=tp2_price, right=bar_index + 12, bottom=entry_price,
                bgcolor=color.new(#089981, 85), border_color=color.new(#089981, 30))
        box.new(left=bar_index, top=entry_price, right=bar_index + 12, bottom=sl_price,
                bgcolor=color.new(#f23645, 85), border_color=color.new(#f23645, 30))

if sell_trigger
    entry_price := close
    sl_price := close + (atr_val * sl_mult)
    risk = sl_price - entry_price
    tp1_price := entry_price - (risk * tp1_mult)
    tp2_price := entry_price - (risk * tp2_mult)
    tp3_price := entry_price - (risk * tp3_mult)

    label.new(bar_index, high + (atr_val * 0.5), "SELL\n" + str.tostring(close, "#.##"),
              color=#f23645, textcolor=color.white, style=label.style_label_down, size=size.small)

    if show_tp_sl
        box.new(left=bar_index, top=entry_price, right=bar_index + 12, bottom=tp2_price,
                bgcolor=color.new(#089981, 85), border_color=color.new(#089981, 30))
        box.new(left=bar_index, top=sl_price, right=bar_index + 12, bottom=entry_price,
                bgcolor=color.new(#f23645, 85), border_color=color.new(#f23645, 30))

// Hidden plots for webhook alert interpolation {{plot("SL Level")}}, etc.
plot(sl_price, "SL Level", display=display.none)
plot(tp1_price, "TP1 Level", display=display.none)
plot(tp2_price, "TP2 Level", display=display.none)
plot(tp3_price, "TP3 Level", display=display.none)
plot(entry_price, "Entry Level", display=display.none)

// ============================================================================
// 6. ALERTS FOR AUTOMATION & WEBHOOKS
// ============================================================================
alertcondition(buy_trigger, title="TradePros Buy Signal",
               message="{\"action\":\"BUY\",\"symbol\":\"{{ticker}}\",\"price\":{{close}},\"time\":\"{{time}}\",\"sl\":{{plot(\"SL Level\")}},\"tp1\":{{plot(\"TP1 Level\")}},\"tp2\":{{plot(\"TP2 Level\")}}}")

alertcondition(sell_trigger, title="TradePros Sell Signal",
               message="{\"action\":\"SELL\",\"symbol\":\"{{ticker}}\",\"price\":{{close}},\"time\":\"{{time}}\",\"sl\":{{plot(\"SL Level\")}},\"tp1\":{{plot(\"TP1 Level\")}},\"tp2\":{{plot(\"TP2 Level\")}}}")
